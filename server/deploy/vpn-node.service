[Unit]
Description=VPN proxy node (Xray VLESS + REALITY)
After=network-online.target
Wants=network-online.target

[Service]
User=vpn
Group=vpn
ExecStart=/usr/local/bin/vpn-node -config /etc/vpn/node.json
Restart=always
RestartSec=3
LimitNOFILE=1048576
# Bind :443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# /var/lib/vpn-node: last user list, so a restart during an API outage keeps serving users.
StateDirectory=vpn-node

[Install]
WantedBy=multi-user.target
