<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing goes into cloud backups or a device-to-device
     transfer. The session token and keys must stay on this phone; a new phone
     gets its own device account (or joins via 多设备 / 恢复购买). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
